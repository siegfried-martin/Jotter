# Copy to .env.local (dev) or .env (prod, next to dist/). Gitignored.
# The Supabase project this server fronts — same URL + publishable/anon key as the SPA.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Where this server listens (behind the reverse proxy in prod).
HOST=127.0.0.1
PORT=8787
# The public origin clients reach this server at (used in OAuth metadata + challenges).
PUBLIC_URL=http://localhost:8787
# The Jotter SPA origin (for links back to notes).
APP_URL=http://localhost:5174
